# --- PostgreSQL ---
# Вариант 1: единая строка подключения
DATABASE_URL="postgres://postgres:ВАШ_ПАРОЛЬ@localhost:5432/electroepil_db"

# Вариант 2 (если не задан DATABASE_URL): отдельные переменные
# PGHOST="localhost"
# PGPORT="5432"
# PGDATABASE="electroepil_db"
# PGUSER="postgres"
# PGPASSWORD="ВАШ_ПАРОЛЬ"

# Включите, если БД требует SSL-соединение
# PGSSL="true"

# --- Telegram (уведомления о новых записях) ---
# Токен бота, выданный @BotFather. ВАЖНО: старый токен скомпрометирован,
# выпустите новый через @BotFather и впишите его сюда.
TELEGRAM_BOT_TOKEN="ВАШ_НОВЫЙ_ТОКЕН_БОТА"
# ID чата/пользователя, куда отправлять уведомления
TELEGRAM_CHAT_ID="ВАШ_CHAT_ID"

# --- Админ-панель ---
# Пароль для входа в /admin. Задайте надёжный пароль.
ADMIN_PASSWORD="придумайте_надёжный_пароль"

# --- Сервер ---
# Порт и хост для продакшен-сервера (npm run start)
PORT="3000"
HOST="0.0.0.0"
